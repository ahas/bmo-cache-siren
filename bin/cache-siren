#!/bin/bash
# cache-siren CLI — status|show|hide|toggle|mute|unmute|local on|off|demo|live|test|tail [N]|restart|log [N]
PORT="${CACHE_SIREN_PORT:-9022}"; B="http://127.0.0.1:$PORT"
# The formatter sits in src/ beside this script's bin/, wherever the tree is installed (a symlink to this script is followed).
SELF="$0"; while [ -L "$SELF" ]; do L="$(readlink "$SELF")"; case "$L" in /*) SELF="$L";; *) SELF="$(dirname "$SELF")/$L";; esac; done
F="$(cd "$(dirname "$SELF")/.." && pwd)/src/cli_fmt.py"
case "${1:-status}" in
  status)  curl -s -m 3 "$B/health" | python3 "$F" status;;
  show)    curl -s -m 3 -X POST "$B/ctl" -d '{"visible":true}' >/dev/null && echo "shown";;
  hide)    curl -s -m 3 -X POST "$B/ctl" -d '{"visible":false}' >/dev/null && echo "hidden";;
  toggle)  v=$(curl -s -m 3 "$B/ctl" | python3 "$F" ctl); curl -s -m 3 -X POST "$B/ctl" -d "{\"visible\":$v}" >/dev/null && echo "visible=$v";;
  mute)    curl -s -m 3 -X POST "$B/ctl" -d '{"muted":true}' >/dev/null && echo "muted";;
  unmute)  curl -s -m 3 -X POST "$B/ctl" -d '{"muted":false}' >/dev/null && echo "unmuted";;
  local)   [ "$2" = on ] && v=true || v=false; curl -s -m 3 -X POST "$B/ctl" -d "{\"show_local\":$v}" >/dev/null && echo "show_local=$v";;
  demo)    curl -s -m 3 -X POST "$B/ctl" -d '{"page":"/demo"}' >/dev/null && echo "switched to demo (frozen screen); back to live: cache-siren live";;
  live)    curl -s -m 3 -X POST "$B/ctl" -d '{"page":"/"}' >/dev/null && echo "switched to live";;
  test)    curl -s -m 5 -X POST "$B/test-siren"; echo;;
  tail)    curl -s -m 3 "$B/events?limit=${2:-20}&local=1" | python3 "$F" tail;;
  restart) launchctl kickstart -k gui/$(id -u)/local.cache-siren && launchctl kickstart -k gui/$(id -u)/local.cache-siren.app && echo "restarted";;
  log)     tail -n "${2:-30}" ~/.claude/cache-siren/cache-siren.log;;
  *) echo "usage: cache-siren status|show|hide|toggle|mute|unmute|local on|off|demo|live|test|tail [N]|restart|log [N]";;
esac
