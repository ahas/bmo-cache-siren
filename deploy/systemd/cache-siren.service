[Unit]
Description=cache-siren — per-request cache and new-token watch for Anthropic requests
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# The deployed tree: bin/ holds the daemon, web/ the pages it serves. The data root is the daemon's data
# directory, kept across releases: the config file, the event log, the offsets, the token and the sound
# stand there. Nothing is written under the default data directory, ~/.claude/cache-siren.
WorkingDirectory=%h/.local/share/bmo-cache-siren/deploy
ExecStart=%h/.local/share/bmo-cache-siren/deploy/bin/bmo-cache-siren serve --config %h/.local/share/bmo-cache-siren/data/config.json --data-dir %h/.local/share/bmo-cache-siren/data --quiet
Restart=always
RestartSec=5
# A stop ends the open streams and keeps the offsets before the daemon exits; the unit waits for that end
# and never escalates to a kill.
TimeoutStopSec=infinity

[Install]
WantedBy=default.target
# Linked, enabled and restarted by every deployment, so the release's pages go live with its binary.
X-BMO-Deploy=restart
